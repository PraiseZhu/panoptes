#!/usr/bin/env python3
"""git credential helper (11-04): https pushes/fetches to github.com authenticate as the Praise QA App, installation by remote:
xindong/* -> 178486896, PraiseZhu/* -> 164262283, aj0928/aj0928-handoff -> 178902423, zhongxingtian-ai/handover-mivo -> 178909971;
a repo with no installation or no path -> prints nothing. Needs
credential.useHttpPath=true so git sends the path. Flag off ($PI_STATE/gh-app-enabled + gh-app-wrapper-enabled) or a mint failure ->
prints nothing, so git asks the next helper (the box's gh / PAT login), exactly as before. store/erase: nothing to do."""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import gh_wrapper as W  # noqa: E402


def parse(text):
    d = {}
    for line in text.splitlines():
        if "=" in line: k, v = line.split("=", 1); d[k] = v
    return d


def main(argv, stdin=sys.stdin, stdout=sys.stdout):
    if not argv or argv[0] != "get": return 0
    d = parse(stdin.read())
    if d.get("protocol") != "https" or d.get("host") != "github.com" or not W.wrapper_on(): return 0
    path = (d.get("path") or "").strip("/")
    if path.endswith(".git"): path = path[:-4]
    repo = "/".join(path.split("/")[:2]) if path.count("/") >= 1 else None
    if not repo: return 0
    if W.lib.product_write_identity(["git", "push"], repo) == "pat": return 0   # 11-05: xindong/* only while product-writes is on
    tok = W.app_token(repo, ["git", "credential"], no_install_is_none=True)   # 11-04: no installation -> nothing
    if tok: stdout.write(f"username=x-access-token\npassword={tok}\n")
    return 0


if __name__ == "__main__": sys.exit(main(sys.argv[1:]))
