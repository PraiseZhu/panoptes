diff --git a/scripts/loops/automerge/state-lock.test.mjs b/scripts/loops/automerge/state-lock.test.mjs
new file mode 100644
index 00000000..fb011155
--- /dev/null
+++ b/scripts/loops/automerge/state-lock.test.mjs
@@ -0,0 +1,22 @@
+// 锁回收的竞争分支:另一个进程正在回收时不抢。
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+import { afterEach, beforeEach, expect, it } from 'vitest'
+
+import { LockHeldError, openState } from './lib/state.mjs'
+
+let dir
+beforeEach(() => { dir = mkdtempSync(join(tmpdir(), 'automerge-lock-')) })
+afterEach(() => rmSync(dir, { recursive: true, force: true }))
+
+it('持锁进程已死但回收目录已存在:报锁被占用,不动原锁', () => {
+  mkdirSync(join(dir, 'lock'))
+  writeFileSync(join(dir, 'lock', 'owner.json'), JSON.stringify({ pid: 999999, startedAt: 1, token: 't' }))
+  mkdirSync(join(dir, 'lock.reclaim'))
+  const state = openState(dir, { alive: () => false })
+  expect(() => state.acquire()).toThrow(LockHeldError)
+  expect(() => state.acquire()).toThrow('另一个进程正在回收锁')
+})
+
