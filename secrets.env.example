# panoptes secrets — copy to /home/box/.config/mivo-qa/secrets.env (or $QA_SECRETS_FILE), chmod 600.
# Never commit the real file. run-nightly.sh sources it with `set -a`.

# Required: GitHub token with read access to xindong/mivo-canvas-plugin
# (and issues:write on PraiseZhu/pr-qa-agent-deploy if you use --create-issues).
GITHUB_TOKEN=

# Required: OpenAI-compatible model gateway used for ming-qa code review and PR summaries.
QA_LLM_BASE_URL=
QA_LLM_API_KEY=

# Optional: Jev dimension triage. Without it every optional check runs for every PR and the report notes
# 维度适用性未判定（Jev 未配置）.
# ARGUS_TYPESAFE_API_KEY=

# Optional: external test account for the api-probe signed-in probes. Only needed for target revisions that do NOT
# export the setCindyJwksLoader test seam (current main does; then a locally signed token is used instead).
# Never a production account. Either a ready token, or user + password + an OAuth password-grant token URL.
# MIVO_QA_TEST_TOKEN=
# MIVO_QA_TEST_USER=
# MIVO_QA_TEST_PASSWORD=
# MIVO_QA_TEST_TOKEN_URL=
# MIVO_QA_TEST_CLIENT_ID=
# MIVO_QA_TEST_SCOPE=

# Optional: gitleaks binary for the secret-scan step (otherwise /usr/local/bin/gitleaks, /workspace/_tools/gitleaks, PATH).
# ARGUS_GITLEAKS_BIN=

# Optional: Feishu (Lark) Mivo bot app credentials. Used by scripts/refresh-roster.py
# (open_id lookup), scripts/send-feishu-dm.mjs (P0/P1 author DMs) and report/send-feishu-report.mjs (daily report).
# Leave empty to disable.
MIVO_FEISHU_APP_ID=
MIVO_FEISHU_APP_SECRET=
