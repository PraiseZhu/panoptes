# panoptes catch-up — installed by scripts/bootstrap-box.sh into /etc/cron.d/panoptes-catch-up (do not edit there;
# a box replacement wipes /etc, the next bootstrap re-installs it). Pure script, no model calls: every even Beijing hour (cron fires hourly at :07, run-nightly.sh skips odd Beijing hours: PANOPTES_CATCHUP_GATE=even),
# list PRs merged yesterday + today (Asia/Shanghai), test only those without a matching reports/merged/PR-N.json
# (through the run lock), exit 0 within seconds when nothing is missing. run-nightly.sh also sweeps stale /tmp/argus-*
# dirs (scripts/sweep-tmp.sh, > 24 h, not in use) at every start, i.e. on every cron tick.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
7 * * * * @USER@ PANOPTES_CATCHUP_GATE=even QA_HOME=@QA_HOME@ @PANOPTES_DIR@/run-nightly.sh --catch-up --trigger catch-up --wait-lock 14400 >>@QA_HOME@/argus-root/logs/catch-up-cron.log 2>&1
