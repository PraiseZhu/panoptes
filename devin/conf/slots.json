{
  "schema": "devin.slots/v1",
  "source": "pi/cron/pi-line.cron",
  "timezone": "Asia/Shanghai",
  "platform": "linux",
  "route": "slot_job",
  "match_window_min": 10,
  "lock_branch": "devin-lock",
  "lock_stale_min": 30,
  "note": "14 Beijing-time slots that replace Bot 1's daily cron entries of pi/cron/pi-line.cron. Every job of a slot runs through pi/bin/run.sh in order (the cron @HH gate is dropped: pi-slot.sh picks the slot). cron[] lists each cron entry folded into the slot with its original Beijing time; offset_min != 0 marks the three deliberate alignments listed in alignments[].",
  "alignments": [
    {"job": "credcheck", "cron": "07:01", "slot": "07:00", "why": "credcheck @07 fires at :01; a slot of its own at the full hour, one minute earlier, before the 07:35 daily"},
    {"job": "roster", "cron": "08:23", "slot": "08:20", "why": "roster @08 fires at :23; moved 3 minutes earlier onto a 10-minute grid slot, still before the 08:35 daily retry"},
    {"job": "followup", "cron": "06:27", "slot": "06:20", "why": "followup @06,15 fires at :27; merged into the 06:20 handoff slot and runs right after handoff"},
    {"job": "followup", "cron": "15:27", "slot": "15:20", "why": "followup @06,15 fires at :27; merged into the 15:20 handoff slot and runs right after handoff"}
  ],
  "slots": [
    {"at": "00:05", "jobs": [{"job": "handoff", "args": []}],
     "cron": [{"entry": "5  * * * * box $R handoff @00", "job": "handoff", "cron_at": "00:05", "offset_min": 0}]},
    {"at": "06:20", "jobs": [{"job": "handoff", "args": []}, {"job": "followup", "args": []}],
     "cron": [{"entry": "20 * * * * box $R handoff @06,15", "job": "handoff", "cron_at": "06:20", "offset_min": 0},
              {"entry": "27 * * * * box $R followup @06,15", "job": "followup", "cron_at": "06:27", "offset_min": -7}]},
    {"at": "07:00", "jobs": [{"job": "credcheck", "args": []}],
     "cron": [{"entry": "1  * * * * box $R credcheck @07", "job": "credcheck", "cron_at": "07:01", "offset_min": -1}]},
    {"at": "07:35", "warmup_at": "07:30", "jobs": [{"job": "daily", "args": []}],
     "cron": [{"entry": "35 * * * * box $R daily @07,08", "job": "daily", "cron_at": "07:35", "offset_min": 0}]},
    {"at": "08:20", "jobs": [{"job": "roster", "args": []}],
     "cron": [{"entry": "23 * * * * box $R roster @08", "job": "roster", "cron_at": "08:23", "offset_min": -3}]},
    {"at": "08:35", "jobs": [{"job": "daily", "args": []}],
     "cron": [{"entry": "35 * * * * box $R daily @07,08", "job": "daily", "cron_at": "08:35", "offset_min": 0}]},
    {"at": "09:30", "jobs": [{"job": "opsfix", "args": ["retest", "--execute"]}],
     "cron": [{"entry": "30 * * * * box $R opsfix @09,12,16,20 retest --execute", "job": "opsfix", "cron_at": "09:30", "offset_min": 0}]},
    {"at": "09:50", "jobs": [{"job": "handoff", "args": ["backfill"], "unless_exists": "pi/handoff-backfill-off"}],
     "cron": [{"entry": "50 * * * * box [ -e /workspace/mivo-qa/pi/handoff-backfill-off ] || $R handoff @09 backfill", "job": "handoff", "cron_at": "09:50", "offset_min": 0}]},
    {"at": "12:30", "jobs": [{"job": "opsfix", "args": ["retest", "--execute"]}],
     "cron": [{"entry": "30 * * * * box $R opsfix @09,12,16,20 retest --execute", "job": "opsfix", "cron_at": "12:30", "offset_min": 0}]},
    {"at": "15:20", "jobs": [{"job": "handoff", "args": []}, {"job": "followup", "args": []}],
     "cron": [{"entry": "20 * * * * box $R handoff @06,15", "job": "handoff", "cron_at": "15:20", "offset_min": 0},
              {"entry": "27 * * * * box $R followup @06,15", "job": "followup", "cron_at": "15:27", "offset_min": -7}]},
    {"at": "16:30", "jobs": [{"job": "opsfix", "args": ["retest", "--execute"]}],
     "cron": [{"entry": "30 * * * * box $R opsfix @09,12,16,20 retest --execute", "job": "opsfix", "cron_at": "16:30", "offset_min": 0}]},
    {"at": "18:35", "jobs": [{"job": "handoff", "args": []}],
     "cron": [{"entry": "35 * * * * box $R handoff @18", "job": "handoff", "cron_at": "18:35", "offset_min": 0}]},
    {"at": "20:30", "jobs": [{"job": "opsfix", "args": ["retest", "--execute"]}],
     "cron": [{"entry": "30 * * * * box $R opsfix @09,12,16,20 retest --execute", "job": "opsfix", "cron_at": "20:30", "offset_min": 0}]},
    {"at": "23:40", "jobs": [{"job": "ledger", "args": []}],
     "cron": [{"entry": "40 * * * * box $R ledger @23", "job": "ledger", "cron_at": "23:40", "offset_min": 0}]}
  ]
}
